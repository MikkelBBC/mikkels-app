{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mikkels-app",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "app.py"
      ],
      "port": 8770
    },
    {
      "name": "mikkels-app-web",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8790",
        "--bind",
        "127.0.0.1",
        "--directory",
        "_site"
      ],
      "port": 8790
    }
  ]
}
